guild_dj_roles:     Dict[int, int] = {}          # guild_id -> role_id
vote_skips:         Dict[int, Set[int]] = defaultdict(set)
stay_247:           Dict[int, bool] = defaultdict(bool)
# Every auto-downloaded file in existence, for shutdown cleanup
ALL_DOWNLOADED_FILES: Set[str] = set()


def save_playlists(data: dict) -> None:
    try:
        with open(PLAYLISTS_FILE, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except Exception as e:
        bot_logger.error(f"Failed to save playlists: {e}")


def load_playlists() -> dict:
    if not os.path.exists(PLAYLISTS_FILE):
        return {}
    try:
        with open(PLAYLISTS_FILE, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception as e:
        bot_logger.error(f"Failed to load playlists: {e}")
        return {}


def delete_song_file(song: dict) -> None:
    """Delete a song's backing file if it was auto-downloaded (never local user files)."""
    if song.get('source') != 'download':
        return
    path = song.get('url')
    if not path:
        return
    try:
        if os.path.exists(path):
            os.remove(path)
            bot_logger.info(f"Deleted download: {path}")
        ALL_DOWNLOADED_FILES.discard(path)
    except Exception as e:
        bot_logger.error(f"Failed to delete {path}: {e}")


def rebuild_queue(state: 'GuildState') -> None:
    """Re-sync the underlying asyncio.Queue from queue_list (must hold state.lock)."""
    state.queue._queue.clear()
    for item in state.queue_list:
        state.queue._queue.append(item)


def is_dj(ctx, guild_id: int) -> bool:
    """Return True if the caller has DJ privileges for this guild."""
    author = getattr(ctx, 'author', None)
    if author is None or not isinstance(author, discord.Member):
        return True  # DMs / mocks
    if author.guild_permissions.administrator or author.guild_permissions.manage_guild:
        return True
    role_id = guild_dj_roles.get(guild_id)
    if not role_id:
        return True  # no DJ role set -> everyone is DJ (backwards compatible)
    dj_role = ctx.guild.get_role(role_id) if getattr(ctx, 'guild', None) else None
    return dj_role is not None and dj_role in author.roles


def is_admin(ctx) -> bool:
    author = getattr(ctx, 'author', None)
    return isinstance(author, discord.Member) and author.guild_permissions.administrator


# ==================== Guild State ====================
@dataclass
class GuildState:
    guild_id: int
    queue: asyncio.Queue = field(default_factory=asyncio.Queue)
    queue_list: List[Dict[str, Any]] = field(default_factory=list)
    history: List[Dict[str, Any]] = field(default_factory=list)
    current_song: Optional[Dict[str, Any]] = None
    loop_type: Optional[str] = None  # 'queue', 'song', or None
    is_playing: bool = False
    playback_active: bool = False
    playback_task: Optional[asyncio.Task] = None
    voice_client: Optional[discord.VoiceClient] = None
    lock: asyncio.Lock = field(default_factory=asyncio.Lock)
    download_semaphore: asyncio.Semaphore = field(
        default_factory=lambda: asyncio.Semaphore(MAX_CONCURRENT_DL)
    )
    start_time: float = 0.0
    last_activity: float = field(default_factory=time.time)
    data_usage: int = 0
    audio_filter: Optional[str] = None
    downloaded_files: Set[str] = field(default_factory=set)

    async def start_playback_loop(self, ctx: commands.Context) -> None:
        if self.playback_task and not self.playback_task.done():
            return
        self.playback_task = asyncio.create_task(self._playback_loop(ctx))
        bot_logger.info(f"Started playback loop for guild {self.guild_id}")

    async def stop_playback_loop(self) -> None:
        if self.playback_task and not self.playback_task.done():
            self.playback_task.cancel()
            try:
                await self.playback_task
            except asyncio.CancelledError:
                pass
        self.is_playing = False
        self.playback_active = False
        bot_logger.info(f"Stopped playback loop for guild {self.guild_id}")

    async def cleanup_downloads(self) -> int:
        """Delete every auto-downloaded file tracked for this guild."""
        count = 0
        for path in list(self.downloaded_files):
            try:
                if os.path.exists(path):
                    os.remove(path)
                    count += 1
            except Exception as e:
                bot_logger.error(f"Failed to delete {path}: {e}")
            ALL_DOWNLOADED_FILES.discard(path)
        self.downloaded_files.clear()
        # Also sweep queue_list / history for anything we missed
        for song in list(self.queue_list) + list(self.history) + ([self.current_song] if self.current_song else []):
            if song and song.get('source') == 'download':
                delete_song_file(song)
        return count

    async def _playback_loop(self, ctx: commands.Context) -> None:
        while True:
            try:
                if not self.playback_active and not self.is_playing:
                    await self._play_next_safe(ctx)
                await asyncio.sleep(1)
            except asyncio.CancelledError:
                break
            except Exception:
                bot_logger.error(f"Playback loop error in guild {self.guild_id}: {traceback.format_exc()}")
                await asyncio.sleep(5)

    async def _safe_send(self, ctx: commands.Context, content: str, **kwargs):
        try:
            return await ctx.send(content, **kwargs)
        except Exception as e:
            bot_logger.warning(f"Safe send failed in guild {self.guild_id}: {e}")
            return None

    async def _play_next_safe(self, ctx: commands.Context) -> None:
        """Thread-safe next-song playback with proper state management."""
        try:
            # Atomic check-and-set (no awaits between)
            if self.playback_active or (ctx.voice_client and ctx.voice_client.is_playing()):
                return
            self.playback_active = True

            # Ensure voice connection
            if not ctx.voice_client or not ctx.voice_client.is_connected():
                channel = None
                if hasattr(ctx.author, 'voice') and ctx.author.voice:
                    channel = ctx.author.voice.channel
                elif self.guild_id in last_join_channels:
                    channel = last_join_channels[self.guild_id]
                if channel and isinstance(channel, discord.VoiceChannel):
                    try:
                        await channel.connect(timeout=VOICE_TIMEOUT, reconnect=True)
                        bot_logger.info(f"Reconnected to voice in guild {self.guild_id}")
                    except Exception as e:
                        bot_logger.error(f"Voice reconnect failed: {e}")
                        self.is_playing = False
                        self.playback_active = False
                        return
                else:
                    self.is_playing = False
                    self.playback_active = False
                    return

            # Get next song
            song = None
            if self.loop_type == 'song' and self.current_song:
                song = self.current_song
            else:
                while not song:
                    if self.queue.empty():
                        if self.loop_type == 'queue' and self.history:
                            for track in self.history:
                                await self.queue.put(track)
                                async with self.lock:
                                    self.queue_list.append(track)
                            continue
                        break
                    candidate = await self.queue.get()
                    async with self.lock:
                        if self.queue_list and self.queue_list[0] is candidate:
                            self.queue_list.pop(0)
                    if not candidate.get('removed'):
                        song = candidate
                        self.history.append(song)

            if not song:
                self.is_playing = False
                self.playback_active = False
                return

            self.current_song = song
            vote_skips[self.guild_id].clear()
            self.start_time = time.time()
            self.is_playing = True
            self.last_activity = time.time()

            # Verify file
            filepath = song['url']
            if not os.path.exists(filepath):
                bot_logger.error(f"File missing: {filepath}")
                await self._safe_send(ctx, f"File missing: {song['title']}")
                base = os.path.splitext(filepath)[0]
                for ext in SUPPORTED_AUDIO_EXTENSIONS:
                    test = base + ext
                    if os.path.exists(test):
                        song['url'] = test
                        break
                else:
                    self.playback_active = False
                    asyncio.create_task(self._play_next_safe(ctx))
                    return

            try:
                if os.path.getsize(song['url']) == 0:
                    raise ValueError("empty file")
            except Exception as e:
                bot_logger.error(f"File access error {song['url']}: {e}")
                await self._safe_send(ctx, f"Cannot read file: {song['title']}")
                self.playback_active = False
                asyncio.create_task(self._play_next_safe(ctx))
                return

            # Create audio source (with active filter)
            try:
                source = TrackedFFmpegPCMAudio(
                    song['url'], guild_id=self.guild_id, filter_name=self.audio_filter
                )
            except Exception as e:
                bot_logger.error(f"Audio source failed {song['url']}: {e}")
                await self._safe_send(ctx, f"Audio format error: {song['title']}")
                self.playback_active = False
                asyncio.create_task(self._play_next_safe(ctx))
                return

            def after_playback(error):
                self.playback_active = False
                self.is_playing = False
                if error:
                    bot_logger.error(f"Playback error in guild {self.guild_id}: {error}")
                asyncio.run_coroutine_threadsafe(self._play_next_safe(ctx), bot.loop)

            try:
                ctx.voice_client.play(source, after=after_playback)
                await self._safe_send(ctx, f"Now Playing: **{song['title']}**")
            except discord.ClientException as e:
                if "Already playing audio" in str(e):
                    bot_logger.warning(f"Playback race in guild {self.guild_id}, retrying")
                    self.playback_active = False
                    await asyncio.sleep(1)
                    asyncio.create_task(self._play_next_safe(ctx))
                else:
                    raise
        except Exception:
            self.playback_active = False
            bot_logger.error(f"Playback error in guild {self.guild_id}: {traceback.format_exc()}")
            await self._safe_send(ctx, "Playback error occurred")


guild_states: Dict[int, GuildState] = {}


def get_guild_state(guild_id: int) -> GuildState:
    if guild_id not in guild_states:
        guild_states[guild_id] = GuildState(guild_id)
    return guild_states[guild_id]


# ==================== Audio Source ====================
class TrackedFFmpegPCMAudio(discord.FFmpegPCMAudio):
    def __init__(self, source, guild_id, filter_name: Optional[str] = None, **kwargs):
        options = "-loglevel warning -analyzeduration 0 -bufsize 2048k"
        if filter_name and filter_name in SONG_FILTERS:
            fs = SONG_FILTERS[filter_name]
            if fs:
                options += f' -af "{fs}"'
        super().__init__(source, executable=FFMPEG_PATH, options=options, **kwargs)
        self.guild_id = guild_id

    def read(self):
        data = super().read()
        if data:
            DATA_USAGE[self.guild_id]['total_bytes'] += len(data)
        return data


# ==================== Mock / Interaction Contexts ====================
class MockContext:
    """Context used by the CLI admin tool."""
    def __init__(self, guild: discord.Guild, channel: Optional[discord.TextChannel] = None):
        self.guild = guild
        self.voice_client = guild.voice_client
        self.author = type('MockAuthor', (), {
            'display_name': 'CLI Admin',
            'id': 0,
            'guild_permissions': discord.Permissions.all(),
            'voice': type('MockVoice', (), {
                'channel': guild.voice_client.channel if guild.voice_client else None
            })()
        })()
        self.bot = guild.me
        self.channel = channel
        self.message = type('MockMessage', (), {
            'guild': guild, 'author': self.author,
            'channel': channel, 'content': ''
        })()

    async def send(self, content, **kwargs):
        if self.channel:
            try:
                return await self.channel.send(content, **kwargs)
            except Exception as e:
                print(f"[Bot Error] Failed to send message: {e}")
                return None
        else:
            print(f"[Bot] {content}")
            return None


class InteractionContext:
    """Adapts a discord.Interaction to look like commands.Context."""
    def __init__(self, interaction: discord.Interaction):
        self.interaction = interaction
        self.guild = interaction.guild
        self.author = interaction.user
        self.voice_client = interaction.guild.voice_client if interaction.guild else None
        self.channel = interaction.channel
        self.message = None

    async def send(self, content, **kwargs):
        # Slash-command caller must have deferred first
        return await self.interaction.followup.send(content, **kwargs)


# ==================== Search Helpers ====================
async def search_youtube(query: str, limit: int = 5) -> List[dict]:
    """Robust YouTube search returning validated entries."""
    query = query.strip()
    if not query or len(query) > 200:
        return []
    try:
        info = await downloader.extract_info(f"ytsearch{limit}:{query}", download=False)
        if not info or 'entries' not in info:
            return []
        return [e for e in info['entries']
                if e and e.get('id') and e.get('title')]
    except Exception as e:
        bot_logger.error(f"Search failed for '{query}': {e}")
        return []


# ==================== Downloader ====================
class Downloader:
    """Hyperthreaded audio downloader with yt-dlp."""

    def __init__(self):
        self.executor = ThreadPoolExecutor(max_workers=MAX_CONCURRENT_DL, thread_name_prefix='dl')
        self.ydl_opts_base = {
            'format': 'bestaudio/best',
            'outtmpl': os.path.join(DOWNLOADS_DIR, '%(title).150B [%(id)s].%(ext)s'),
            'postprocessors': [{
                'key': 'FFmpegExtractAudio',
                'preferredcodec': 'mp3',
                'preferredquality': '192',
            }],
            'socket_timeout': DOWNLOAD_TIMEOUT,
            'retries': 3,
            'quiet': True,
            'no_warnings': True,
            'noplaylist': True,
            'logger': yt_logger,
        }

    async def extract_info(self, url: str, download: bool = False, process: bool = True) -> dict:
        opts = self.ydl_opts_base.copy()
        if not download:
            opts['extract_flat'] = 'in_playlist'

        def _extract():
            with youtube_dl.YoutubeDL(opts) as ydl:
                return ydl.extract_info(url, download=download, process=process)

        return await asyncio.get_event_loop().run_in_executor(self.executor, _extract)

    async def download_single(self, url: str) -> Optional[Dict[str, Any]]:
        try:
            info = await self.extract_info(url, download=True)
            if not info:
                return None
            filepath = youtube_dl.YoutubeDL(self.ydl_opts_base).prepare_filename(info)
            base = os.path.splitext(filepath)[0]
            for ext in SUPPORTED_AUDIO_EXTENSIONS:
                test = base + ext
                if os.path.exists(test):
                    filepath = test
                    break
            abs_path = os.path.abspath(filepath)
            ALL_DOWNLOADED_FILES.add(abs_path)
            return {
                'title': info.get('title', 'Unknown Track'),
                'url': abs_path,
                'webpage_url': info.get('webpage_url', url),
                'duration': info.get('duration', 0),
                'source': 'download',
            }
        except Exception as e:
            bot_logger.error(f"Download failed for {url}: {e}")
            return None

    async def download_playlist_batch(
        self, entries: List[Dict], requester: str,
        progress_callback=None, state: Optional[GuildState] = None,
    ) -> List[Dict]:
        """Hyperthreaded playlist download with semaphore control."""
        semaphore = asyncio.Semaphore(MAX_CONCURRENT_DL)
        capped = entries[:MAX_PLAYLIST_ITEMS]

        async def download_one(entry):
            async with semaphore:
                video_url = (entry.get('webpage_url')
                             or entry.get('url')
                             or f"https://youtu.be/{entry['id']}")
                song = await self.download_single(video_url)
                if song:
                    song['requester'] = requester
                    if state is not None:
                        state.downloaded_files.add(song['url'])
                    if progress_callback:
                        try:
                            await progress_callback(song)
                        except Exception:
                            pass
                return song

        tasks = [download_one(e) for e in capped if e]
        results = await asyncio.gather(*tasks, return_exceptions=True)
        return [r for r in results if isinstance(r, dict)]


downloader = Downloader()


# ==================== Music Cog ====================
class Music(commands.Cog):
    def __init__(self, bot: commands.Bot):
        self.bot = bot

    # ---------- helpers ----------
    async def ensure_voice(self, ctx: commands.Context) -> bool:
        if ctx.voice_client and ctx.voice_client.is_connected():
            return True
        if not getattr(ctx.author, 'voice', None) or not ctx.author.voice:
            await ctx.send("You need to be in a voice channel first!")
            return False
        channel = ctx.author.voice.channel
        try:
            await channel.connect(timeout=VOICE_TIMEOUT, reconnect=True)
            last_join_channels[ctx.guild.id] = channel
            return True
        except Exception as e:
            bot_logger.error(f"Voice connection failed: {e}")
            await ctx.send("Failed to connect to voice channel")
            return False

    async def _check_dj(self, ctx: commands.Context) -> bool:
        if is_dj(ctx, ctx.guild.id):
            return True
        await ctx.send("You need the DJ role or `Manage Server` permission.")
        return False

    # ---------- playback entry points ----------
    @commands.command(name='join', aliases=['getinherelittleboy'])
    async def join(self, ctx: commands.Context):
        if not await self.ensure_voice(ctx):
            return
        await ctx.send(f"Joined **{ctx.author.voice.channel.name}**")

    @commands.command(name='leave')
    async def leave(self, ctx: commands.Context):
        if not await self._check_dj(ctx):
            return
        state = get_guild_state(ctx.guild.id)
        await state.stop_playback_loop()
        if ctx.voice_client:
            await ctx.voice_client.disconnect()
        deleted = await state.cleanup_downloads()
        async with state.lock:
            state.queue = asyncio.Queue()
            state.queue_list.clear()
            state.current_song = None
            state.loop_type = None
            state.history.clear()
            state.is_playing = False
            state.playback_active = False
        await ctx.send(f"Left voice and cleared queue (deleted **{deleted}** files)")

    @commands.command(name='stream', aliases=['play', 'p'])
    async def stream(self, ctx: commands.Context, *, query: str = ""):
        if not query:
            await ctx.send("Usage: `!stream <url or search>`")
            return
        if not await self.ensure_voice(ctx):
            return
        state = get_guild_state(ctx.guild.id)

        if query.startswith(('http://', 'https://')):
            if 'list=' in query or 'playlist' in query:
                await self._handle_playlist(ctx, query)
            else:
                await self._handle_single_url(ctx, query)
            return

        entries = await search_youtube(query, limit=5)
        if not entries:
            await ctx.send("No results found.")
            return

        view = SearchView(entries, ctx)
        lines = [f"**Search results for '{query}':**"]
        for idx, entry in enumerate(entries, 1):
            title = (entry.get('title') or 'Unknown')[:60]
            dur = int(entry.get('duration') or 0)
            m, s = divmod(dur, 60)
            lines.append(f"`{idx}.` {title} ({m}:{s:02d})")
        msg = await ctx.send("\n".join(lines), view=view)
        view.message = msg
        await view.wait()

        if view.selected_entry is None:
            try:
                await msg.edit(content="Selection cancelled.", view=None)
            except Exception:
                pass
            return

        url = view.selected_entry.get('webpage_url') or f"https://youtu.be/{view.selected_entry['id']}"
        await self._handle_single_url(ctx, url)

    async def _handle_single_url(self, ctx: commands.Context, url: str):
        state = get_guild_state(ctx.guild.id)
        msg = await ctx.send("Downloading...")
        song = await downloader.download_single(url)
        if not song:
            await msg.edit(content="Failed to download track")
            return
        song['requester'] = ctx.author.display_name
        state.downloaded_files.add(song['url'])
        async with state.lock:
            await state.queue.put(song)
            state.queue_list.append(song)
        await msg.edit(content=f"Added: **{song['title']}**")
        if not state.is_playing:
            await state.start_playback_loop(ctx)

    async def _handle_playlist(self, ctx: commands.Context, url: str):
        state = get_guild_state(ctx.guild.id)
        status = await ctx.send("Analyzing playlist...")
        try:
            info = await downloader.extract_info(url, download=False, process=False)
            entries = [e for e in (info.get('entries') or []) if e][:MAX_PLAYLIST_ITEMS]
            if not entries:
                await status.edit(content="No valid tracks in playlist")
                return
            total = len(entries)
            title = info.get('title', 'Playlist')
            await status.edit(content=f"Downloading **{total}** tracks from **{title}**...")

            progress_msg = await ctx.send(f"Progress: 0/{total}")
            completed = 0

            async def progress_cb(_song):
                nonlocal completed
                completed += 1
                try:
                    await progress_msg.edit(content=f"Progress: {completed}/{total}")
                except Exception:
                    pass

            downloaded = await downloader.download_playlist_batch(
                entries, ctx.author.display_name, progress_callback=progress_cb, state=state
            )
            async with state.lock:
                for song in downloaded:
                    await state.queue.put(song)
                    state.queue_list.append(song)

            if downloaded:
                await progress_msg.edit(
                    content=f"Added **{len(downloaded)}** tracks from **{title}**"
                )
            else:
                await progress_msg.edit(content="Failed to download any tracks")

            if not state.is_playing and downloaded:
                await state.start_playback_loop(ctx)
        except Exception:
            bot_logger.error(f"Playlist error: {traceback.format_exc()}")
            await ctx.send("Failed to process playlist")

    # ---------- playnext ----------
    @commands.command(name='playnext', aliases=['pn'])
    async def playnext(self, ctx: commands.Context, *, args: str = ""):
        """!playnext <queue_num|url|local_file>"""
        if not args:
            await ctx.send("Usage: `!playnext <queue_number|url|local_file>`")
            return
        if not await self.ensure_voice(ctx):
            return
        state = get_guild_state(ctx.guild.id)
        args = args.strip()

        if args.isdigit():
            idx = int(args)
            async with state.lock:
                if idx < 1 or idx > len(state.queue_list):
                    await ctx.send(f"Queue only has {len(state.queue_list)} songs.")
                    return
                song = state.queue_list.pop(idx - 1)
                song.pop('removed', None)
                state.queue_list.insert(0, song)
                rebuild_queue(state)
            await ctx.send(f"Moved **{song['title']}** to next.")

        elif args.startswith(('http://', 'https://')):
            msg = await ctx.send("Downloading...")
            song = await downloader.download_single(args)
            if not song:
                await msg.edit(content="Failed to download")
                return
            song['requester'] = ctx.author.display_name
            state.downloaded_files.add(song['url'])
            async with state.lock:
                state.queue_list.insert(0, song)
                state.queue._queue.appendleft(song)
            await msg.edit(content=f"Added next: **{song['title']}**")

        else:
            if not os.path.exists(args):
                await ctx.send(f"File not found: `{args}`")
                return
            song = {
                'title': os.path.basename(args),
                'url': os.path.abspath(args),
                'requester': ctx.author.display_name,
                'duration': 0,
                'source': 'local',
            }
            async with state.lock:
                state.queue_list.insert(0, song)
                state.queue._queue.appendleft(song)
            await ctx.send(f"Added next: **{song['title']}**")

        if not state.is_playing:
            await state.start_playback_loop(ctx)

    # ---------- queue display ----------
    @commands.command(name='queue', aliases=['q'])
    async def queue_cmd(self, ctx: commands.Context):
        state = get_guild_state(ctx.guild.id)
        if not state.current_song and not state.queue_list:
            await ctx.send("Queue is empty")
            return

        chunks: List[str] = []
        current: List[str] = []

        if state.current_song:
            elapsed = int(time.time() - state.start_time)
            dur = int(state.current_song.get('duration') or 0)
            e_str = f"{elapsed//60}:{elapsed%60:02d}"
            d_str = f"{dur//60}:{dur%60:02d}" if dur else "??:??"
            current.append(f"**Now Playing:** {state.current_song['title']}")
            current.append(f"`{e_str}/{d_str}` | {state.current_song.get('requester', '?')}")

        if state.queue_list:
            current.append("\n**Upcoming:**" if current else "**Upcoming:**")
            for idx, song in enumerate(state.queue_list, 1):
                dur = int(song.get('duration') or 0)
                d_str = f"{dur//60}:{dur%60:02d}" if dur else "??:??"
                line = f"`{idx}.` {song['title']} ({d_str}) | {song.get('requester', '?')}"
                if len('\n'.join(current + [line])) > 1900:
                    chunks.append('\n'.join(current))
                    current = ["**Upcoming (cont'd):**", line]
                else:
                    current.append(line)

        if current:
            chunks.append('\n'.join(current))
        for c in chunks:
            await ctx.send(c)

